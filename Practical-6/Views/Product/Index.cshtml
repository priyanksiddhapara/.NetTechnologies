@Model List<Practical_6.Models.Product>
    @{
        Layout = null;
    }
    <h2>Product Catalog</h2>

    <p><b>Name:</b> Priyank Siddhapara</p>
    <p><b>Enrollment No:</b> 92510120019</p>
    
    <table border="1">
        <tr>
            <th>Product Id</th>
            <th>Product Name</th>
            <th>Description</th>
            <th>Price</th>
            <th>Category</th>
            <th>Action</th>
        </tr>
        @foreach (var product in Model)
        {
            <tr>
                <td>@product.ProductId</td>
                <td>@product.ProductName</td>
                <td>@product.Description</td>
                <td>@product.Price</td>
                <td>@product.Category</td>
                <td>
                    @Html.ActionLink("View Details", "Details", "Product",
                                     new { id = product.ProductId }, null)
                </td>
            </tr>
        }
    </table>
